{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "trader-naaz-bot"
      }
    }
  ],
  "services": {
    "trader-naaz-bot": {
      "root": ".",
      "buildCommand": "pip install -r requirements.txt"
    }
  }
}
